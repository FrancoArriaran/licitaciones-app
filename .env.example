# Copy to apps/web/.env.local and fill in. Never commit real values.
# Each environment (dev project, production project) has its own values in Vercel.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API Keys. Use the DEV project here, never production.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Only for local db:* commands (Connect > Session pooler, port 5432). Never set it in Vercel.
# Encode #, ?, / and % in the password (%23, %3F, %2F, %25).
SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Cloudflare Turnstile. These are Cloudflare's official test keys: they always pass,
# so local development runs the real verification code. Production uses real keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OpenAI: suggests rubros from the business description during alert setup.
OPENAI_API_KEY=sk-proj-xxx
