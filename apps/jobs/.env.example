# Copy to apps/jobs/.env.local for local runs (pnpm jobs:sync, pnpm jobs:notify).
# In GitHub Actions these are repository secrets (Settings > Secrets and variables > Actions).

# Supabase: Project Settings > API Keys. Same values as NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SECRET_KEY in apps/web/.env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# WhatsApp Cloud API (Meta): WhatsApp > API Setup. Use a system user token (doesn't expire),
# not the 24-hour test token. Only needed to send; `--dry-run` works without them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
